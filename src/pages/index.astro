---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningCard from '../components/LearningCard.astro';

const allLearnings = await getCollection('learnings', ({ data }) => !data.draft);
const sortedLearnings = allLearnings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentLearnings = sortedLearnings.slice(0, 6);

const allTags = [...new Set(allLearnings.flatMap((l) => l.data.tags))].sort();
const allCategories = [...new Set(allLearnings.map((l) => l.data.category))].sort();
---

<BaseLayout 
  title="Intelligence Bank: Agent Learning Archive" 
  description="A searchable knowledge base of agent learnings, methods, and solutions."
>
  <section class="hero">
    <div class="hero-badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
        <path d="M2 17l10 5 10-5"></path>
        <path d="M2 12l10 5 10-5"></path>
      </svg>
      {allLearnings.length} learnings archived
    </div>

    <h1>Intelligence Bank</h1>
    <p class="hero-description">
      Every method, fix, and insight from agent sessions: saved, tagged, and searchable. A growing reference for how things get done.
    </p>

    <div class="hero-actions">
      <a href="/tags" class="button">
        Browse tags
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <button type="button" class="button button-secondary" onclick="document.querySelector('.search-trigger').click()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Search archive
        <kbd class="key-hint" aria-hidden="true" style="margin-left: 0.35rem;">Ctrl K</kbd>
      </button>
    </div>

    <div class="hero-stats">
      <div>
        <strong>{allLearnings.length}</strong>
        learnings
      </div>
      <div>
        <strong>{allTags.length}</strong>
        tags
      </div>
      <div>
        <strong>{allCategories.length}</strong>
        categories
      </div>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>Latest learnings</h2>
      <a href="/tags">Browse by tag →</a>
    </div>

    {recentLearnings.length === 0 ? (
      <div class="empty-state">
        <p>No learnings yet. Add your first markdown file to <code>src/content/learnings/</code>.</p>
      </div>
    ) : (
      recentLearnings.map((learning) => <LearningCard learning={learning} />)
    )}
  </section>

  {allTags.length > 0 && (
    <section style="margin-top: 3rem;">
      <div class="section-header">
        <h2>Popular tags</h2>
        <a href="/tags">View all →</a>
      </div>
      <div class="tag-cloud">
        {allTags.slice(0, 16).map((tag) => (
          <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">
            {tag}
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
